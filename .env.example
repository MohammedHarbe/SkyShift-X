# API mode: "mock" serves labelled simulated data from the in-app mock API.
#           "live" talks to the real FastAPI backend at VITE_API_BASE_URL.
# In live mode the app NEVER falls back to mock data; failures are shown as errors.
VITE_API_MODE=mock
# Base URL of the backend (no trailing slash). Only used in live mode.
VITE_API_BASE_URL=http://localhost:8000
# Artificial latency (ms) of the mock API, to exercise loading states.
VITE_MOCK_LATENCY_MS=250
# "browser" (needs SPA fallback on the host) or "hash" (works on any static host).
VITE_ROUTER=hash
