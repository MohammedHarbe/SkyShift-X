{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyshift-x/api/v1/ErrorEnvelope.schema.json",
  "title": "ErrorEnvelope",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "not_found",
            "validation_error",
            "unsupported_in_demo",
            "unavailable",
            "internal_error"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "error"
  ],
  "additionalProperties": false,
  "description": "Every non-2xx response uses this body."
}
