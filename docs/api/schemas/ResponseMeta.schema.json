{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyshift-x/api/v1/ResponseMeta.schema.json",
  "title": "ResponseMeta",
  "type": "object",
  "properties": {
    "dataOrigin": {
      "type": "string",
      "enum": [
        "mock",
        "live"
      ],
      "description": "mock = in-app demo data; live = real backend"
    },
    "simulated": {
      "type": "boolean",
      "description": "true if ANY measurement in this response is synthetic"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "notice": {
      "description": "Human-readable caveat shown with the data",
      "type": "string"
    }
  },
  "required": [
    "dataOrigin",
    "simulated",
    "generatedAt"
  ],
  "additionalProperties": false,
  "description": "Envelope metadata. The UI renders its SIMULATED/DEMO labels from this, never from guesses."
}
